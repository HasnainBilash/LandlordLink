# Neon pooled connection (host contains "-pooler") — used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection (no "-pooler") — used only by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Only needed on Vercel (nightly jobs: rent billing, demo reset, cleanup).
# Any long random string with no line break at the end (Vercel rejects
# it), e.g.
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# AI assistant for landlords. Free key: https://aistudio.google.com →
# "Get API key". Without it the assistant says it isn't set up.
GEMINI_API_KEY=""
# Optional: models to try in order, and message limits.
# GEMINI_MODEL="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash"
# ASSISTANT_DAILY_LIMIT="50"
# ASSISTANT_DEMO_DAILY_LIMIT="100"
# ASSISTANT_PER_MINUTE_LIMIT="10"
