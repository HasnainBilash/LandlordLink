# Neon pooled connection (host contains "-pooler") — used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection (no "-pooler") — used only by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Only needed on Vercel (nightly demo reset). Any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
