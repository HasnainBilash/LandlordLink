generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: DATABASE_URL = pooled connection (host contains "-pooler"),
  // DIRECT_URL = direct connection, used only by prisma migrate.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  LANDLORD
  TENANT
}

enum FlatStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
}

enum RentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  // The landlord gave up on collecting what is left (e.g. a tenant who
  // moved out owing rent). Excluded from every outstanding total.
  WRITTEN_OFF
}

enum UtilityType {
  ELECTRICITY
  GAS
  WATER
  INTERNET
  SECURITY
  OTHER
}

enum PaymentType {
  RENT
  UTILITY
}

enum NoticeAudience {
  ALL
  TENANTS
  LANDLORDS
}

// ======================================================
// USER
// ======================================================

model User {
  id String @id @default(cuid())

  name         String
  email        String @unique
  passwordHash String

  phone         String?
  tenantProfile TenantProfile?
  role          UserRole

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  ownedBuildings Building[] @relation("BuildingOwner")

  activityLogs ActivityLog[]

  assistantUsage   AssistantUsage[]
  assistantActions AssistantAction[]

  @@index([email])
  @@index([role])
}

// ======================================================
// BUILDING
// ======================================================

model Building {
  id String @id @default(cuid())

  name        String
  address     String
  city        String
  postcode    String?
  country     String  @default("Bangladesh")
  description String?

  imageUrl String?

  status BuildingStatus @default(ACTIVE)

  accessCode String? @unique

  ownerId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation("BuildingOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  floors       Floor[]
  joinRequests JoinRequest[]
  notices      Notice[]
  activityLogs ActivityLog[]
  dailyStats   BuildingDailyStat[]

  @@index([ownerId])
  @@index([status])
}

// ======================================================
// FLOOR
// ======================================================

model Floor {
  id String @id @default(cuid())

  floorNumber Int

  name String?

  buildingId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  flats Flat[]

  @@unique([buildingId, floorNumber])
  @@index([buildingId])
}

// ======================================================
// FLAT
// ======================================================

model Flat {
  id String @id @default(cuid())

  flatNumber String

  bedrooms Int

  bathrooms Int

  monthlyRent Decimal @db.Decimal(10, 2)

  status FlatStatus @default(VACANT)

  floorId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  leases       Lease[]
  joinRequests JoinRequest[]

  @@unique([floorId, flatNumber])
  @@index([floorId])
  @@index([status])
}

// ======================================================
// ENUMS
// ======================================================

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ENDED
}

// ======================================================
// TENANT PROFILE
// ======================================================

model TenantProfile {
  id String @id @default(cuid())

  userId String @unique

  occupation       String?
  nationalId       String? @unique
  emergencyContact String?

  lastNoticesViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leases       Lease[]
  joinRequests JoinRequest[]
}

// ======================================================
// LEASE
// ======================================================

model Lease {
  id String @id @default(cuid())

  tenantId String
  flatId   String

  startDate DateTime
  endDate   DateTime?

  monthlyRent Decimal  @db.Decimal(10, 2)
  deposit     Decimal? @db.Decimal(10, 2)

  status LeaseStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flat   Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)

  rents        Rent[]
  utilityBills UtilityBill[]

  @@index([tenantId])
  @@index([flatId])
  @@index([status])
  @@index([flatId, status])
  @@index([tenantId, status])
}

// ======================================================
// JOIN REQUEST
// ======================================================

model JoinRequest {
  id String @id @default(cuid())

  tenantId   String
  buildingId String
  flatId     String

  message String?

  status JoinRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  flat     Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([buildingId])
  @@index([flatId])
  @@index([status])
  @@index([buildingId, status])
}

// ======================================================
// RENT
// ======================================================

model Rent {
  id String @id @default(cuid())

  leaseId String

  month Int
  year  Int

  amount Decimal @db.Decimal(10, 2)

  dueDate DateTime

  status RentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments PaymentHistory[]

  @@unique([leaseId, month, year])
  @@index([leaseId])
  @@index([status])
  @@index([leaseId, status, dueDate])
}

// ======================================================
// UTILITY BILL
// ======================================================

model UtilityBill {
  id String @id @default(cuid())

  leaseId String

  type UtilityType

  month Int
  year  Int

  amount Decimal @db.Decimal(10, 2)

  dueDate DateTime

  // Utility bills have no status column (it is derived from payments);
  // this marks the unpaid remainder as written off, like RentStatus.WRITTEN_OFF.
  writtenOffAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  payments PaymentHistory[]

  @@unique([leaseId, type, month, year])
  @@index([leaseId])
}

// ======================================================
// PAYMENT HISTORY
// ======================================================

model PaymentHistory {
  id String @id @default(cuid())

  paymentType PaymentType

  rentId        String?
  utilityBillId String?

  amount Decimal @db.Decimal(10, 2)

  paidAt DateTime @default(now())

  transactionRef String?

  createdAt DateTime @default(now())

  rent        Rent?        @relation(fields: [rentId], references: [id], onDelete: Cascade)
  utilityBill UtilityBill? @relation(fields: [utilityBillId], references: [id], onDelete: Cascade)

  @@index([rentId])
  @@index([utilityBillId])
  @@index([paymentType])
}

// ======================================================
// NOTICE
// ======================================================

model Notice {
  id String @id @default(cuid())

  buildingId String

  title String

  content   String
  expiresAt DateTime?

  audience NoticeAudience @default(ALL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([buildingId, createdAt])
}

// ======================================================
// ACTIVITY LOG
// ======================================================

model ActivityLog {
  id String @id @default(cuid())

  userId String

  buildingId String?

  action String

  entity String

  entityId String?

  description String?

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([buildingId])
  @@index([createdAt])
}

// ======================================================
// AI ASSISTANT USAGE
// ======================================================

// How many messages a landlord sent the AI assistant on one day (Asia/Dhaka
// date), for the daily limit.
model AssistantUsage {
  id String @id @default(cuid())

  userId String
  day    String // yyyy-mm-dd

  messages Int @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// A change the AI assistant prepared (record a payment, approve or reject
// a request, post a notice). It only runs when the landlord confirms it,
// and only once.
model AssistantAction {
  id String @id @default(cuid())

  userId String

  kind    String // record_payment | approve_request | reject_request | post_notice
  summary Json // what the landlord was shown: { title, details }
  payload Json // resolved IDs and values used to run it

  status AssistantActionStatus @default(PENDING)
  result String? // the app's message after running it

  createdAt DateTime  @default(now())
  expiresAt DateTime
  decidedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AssistantActionStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

// ======================================================
// RATE LIMITS
// ======================================================

// Fixed-window counters for rate limits (failed sign-ins, sign-ups,
// requests…), shared by every server instance. Old rows are cleared by the
// nightly cleanup job.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// One row per building per day (Bangladesh calendar day): how the building
// stood at the end of that day. Written by the nightly data job
// (/api/cron/daily-stats), which also rebuilds missing days from the
// payment and lease history; read by the trend charts in Reports → Insights.
model BuildingDailyStat {
  id String @id @default(cuid())

  buildingId String
  day        String // yyyy-mm-dd, Bangladesh time

  flats    Int
  occupied Int

  // Unpaid rent and bills (current and former tenants, not written off).
  owed      Decimal @db.Decimal(12, 2)
  // Payments received during the day.
  collected Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, day])
  @@index([day])
}
